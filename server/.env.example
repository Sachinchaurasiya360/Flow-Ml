# Application Settings
APP_NAME=Flow ML
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=False

# API Configuration
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["https://your-domain.example"]

# Database
DATABASE_URL=postgresql://flow_ml_user:change-me@your-db-host:5432/flow_ml?sslmode=require
DB_ECHO=False

# Security (replace before deployment)
SECRET_KEY=replace-with-a-secure-random-32-character-minimum-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=[".csv",".txt",".json"]

# ML Models
MODEL_ARTIFACTS_DIR=./models
MAX_MODEL_VERSIONS=10
DEFAULT_TRAIN_TEST_SPLIT=0.2
DEFAULT_RANDOM_SEED=42

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600
ENABLE_CACHE=False

# S3 Storage (optional)
USE_S3=False
S3_BUCKET=flow-ml-datasets
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY=3600
S3_USE_DATE_PARTITION=True

# Background Workers (optional)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
ENABLE_BACKGROUND_TASKS=False

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# ML Performance
MODEL_CACHE_SIZE=10
LAZY_LOAD_MODELS=True
ENABLE_MODEL_WARMUP=False

# Admin Credentials (replace before deployment)
ADMIN_EMAIL=admin@flowml.com
ADMIN_PASSWORD=change-this-password

# GenAI API Keys (optional)
DYNAROUTE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
